  "limits": [
    {
      "id": "L-B1-OFF",
      "equipment": "B-1",
      "action": "shutdown",
      "max_minutes": 20,
      "condition": "while an R-201 batch is in hold",
      "consequence_en": "the R-201 batch cools below its 55 °C safe window and unreacted reagent starts to build up, which can run away on restart",
      "consequence_hi": "R-201 का बैच 55 डिग्री से नीचे ठंडा होने लगेगा और बिना रिएक्ट हुआ केमिकल जमा होने लगेगा",
      "source": "SOP-R201-07 §4.2",
      "doc": {
        "doc": "SOP-R201-07",
        "section": "4.2"
      }
    },
